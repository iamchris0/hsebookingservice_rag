{
	# Порт 80 закрыт firewall'ом, поэтому редирект HTTP -> HTTPS не нужен.
	# Сертификат выпускается через TLS-ALPN на 443.
	auto_https disable_redirects
}

{$SITE_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Реестр Data Culture (отдельный проект /root/hse_dc, контейнер dc-app в сети deploy_default)
admin.tadc-hse.ru {
	encode zstd gzip
	reverse_proxy dc-app:4000
}

# Старые и альтернативные адреса (www, временный sslip.io) -> основной домен.
{$REDIRECT_DOMAINS} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
