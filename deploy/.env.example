# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.

# Основной адрес сайта. После смены нужна пересборка фронта: docker compose up -d --build
SITE_DOMAIN=tadc-hse.ru
# Адреса, которые перенаправляются на основной (через запятую с пробелом)
REDIRECT_DOMAINS=www.tadc-hse.ru, 159-194-254-206.sslip.io

POSTGRES_DB=dcbot
POSTGRES_USER=dcbot
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Пароль роли viewer (только чтение, для DataLens). Сгенерировать: openssl rand -hex 24
VIEWER_PASSWORD=

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=
# Пароль, который вводят преподаватели при регистрации
STAFF_SECRET=

# Куда на сервере складывать дампы и сколько последних хранить
BACKUP_DIR=/root/backups
BACKUP_KEEP=8

# Папка на Яндекс Диске и сколько дней хранить там архивы
YADISK_DIR=hsebooking-backups
YADISK_KEEP_DAYS=90
