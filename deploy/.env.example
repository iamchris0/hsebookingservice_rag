# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.

# Адрес сайта. Пока нет своего домена — sslip.io (ведёт на IP сервера).
# После смены домена нужна пересборка фронта: docker compose up -d --build
SITE_DOMAIN=159-194-254-206.sslip.io

POSTGRES_DB=dcbot
POSTGRES_USER=dcbot
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=
# Пароль, который вводят преподаватели при регистрации
STAFF_SECRET=

# Куда на сервере складывать дампы и сколько последних хранить
BACKUP_DIR=/root/backups
BACKUP_KEEP=8
